# ==============================================================================
# MyArea24 — Staging Environment Configuration Template
# ==============================================================================
# Security Policy:
# 1. DO NOT commit actual secrets, private tokens, or customer credentials to Git.
# 2. Copy this file to '.env.staging' on your staging host and populate placeholders.
# 3. Ensure permissions are restricted (e.g. chmod 600 .env.staging).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Settings
# ------------------------------------------------------------------------------
APP_ENV=staging
APP_NAME=MyArea24
LOG_LEVEL=INFO
DEBUG=false

# Port on which FastAPI Uvicorn listener binds inside container / VM
PORT=8000

# Strict CORS: specify only your verified staging domain(s)
# Modern browsers reject credentialed requests with wildcard origins
ALLOWED_ORIGINS=["https://staging.myarea24.in","https://preview.myarea24.in"]
ALLOWED_ORIGIN_REGEX=^https://([a-zA-Z0-9-]+\.)?myarea24\.in$

# ------------------------------------------------------------------------------
# 2. Staging Database (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For local Docker staging: postgresql+psycopg2://myarea24_staging:secure_staging_password@postgres_staging:5432/myarea24_staging
DATABASE_URL=postgresql+psycopg2://myarea24_staging:YOUR_STAGING_DB_PASSWORD_HERE@staging-db.internal:5432/myarea24_staging

# Connection Pooling Settings for Managed Staging PostgreSQL
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT & OTP)
# ------------------------------------------------------------------------------
# REQUIRED: Generate a 64+ char random hex key (e.g. `openssl rand -hex 32`)
# The application will refuse to start in staging if the default dev key is present.
JWT_SECRET_KEY=REPLACE_WITH_UNIQUE_CRYPTOGRAPHIC_STAGING_KEY_MIN_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# In staging, OTP_DEV_MODE MUST be false to ensure test users undergo real authentication
OTP_DEV_MODE=false

# ------------------------------------------------------------------------------
# 4. SMS & Email Delivery Gateways
# ------------------------------------------------------------------------------
# Configure a real SMS provider for genuine mobile OTP verification.
# Option A: Fast2SMS (Indian Mobile Delivery)
FAST2SMS_API_KEY=your_staging_fast2sms_api_key_here

# Option B: Twilio (Global SMS Delivery)
TWILIO_ACCOUNT_SID=your_staging_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_staging_twilio_auth_token_here
TWILIO_FROM_PHONE=+1XXXXXXXXXX

# SMTP Credentials for Email OTPs
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_smtp_api_key_here
SMTP_FROM=no-reply-staging@myarea24.in
SMTP_TLS=true

# Alternative Transactional Email: Resend
RESEND_API_KEY=your_staging_resend_api_key_here

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Razorpay Staging / Test Mode)
# ------------------------------------------------------------------------------
# Use Razorpay Test Mode credentials (rzp_test_...) for staging.
# Cryptographic HMAC-SHA256 signature verification is actively enforced.
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET_HERE

# ------------------------------------------------------------------------------
# 6. External Telemetry & AI Services (Staging Keys)
# ------------------------------------------------------------------------------
# Google Gemini 3.5 Flash Model
GEMINI_API_KEY=your_staging_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Sarvam AI (Indian Language TTS & Speech-to-Text)
SARVAM_API_KEY=your_staging_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai

# Google Maps Platform (Restricted to staging domain)
GOOGLE_MAPS_API_KEY=your_staging_google_maps_api_key_here

# Weather & Traffic Telemetry Providers
WEATHERAPI_API_KEY=your_staging_weatherapi_key_here
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
OPENWEATHERMAP_API_KEY=your_staging_openweathermap_key_here
TOMTOM_API_KEY=your_staging_tomtom_api_key_here
OPENAQ_API_KEY=your_staging_openaq_api_key_here

# Ingestion Switch: set to true if running telemetry background polling in staging
INGESTION_ENABLED=false

# ------------------------------------------------------------------------------
# 7. Frontend Client Environment Variables (Bundled into SPA by Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://staging.myarea24.in/api
VITE_WS_BASE_URL=wss://staging.myarea24.in/api/v1/ws
VITE_GEMINI_API_KEY=your_staging_gemini_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_staging_google_maps_api_key_here
VITE_TOMTOM_API_KEY=your_staging_tomtom_api_key_here
VITE_WEATHERAPI_API_KEY=your_staging_weatherapi_key_here
VITE_OPENAQ_API_KEY=your_staging_openaq_api_key_here
VITE_SARVAM_API_KEY=your_staging_sarvam_api_key_here
